name: "transformer_ts"
backend: "pytorch_libtorch"
max_batch_size: 128

input [
  {
    name: "input__0"
    data_type: TYPE_FP32
    dims: [ 32, 16 ]
  }
]

output [
  {
    name: "output__0"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 1, 4, 16, 32 ]
  max_queue_delay_microseconds: 500
}

instance_group [
  {
    kind: KIND_GPU
    count: 1
    gpus: [ 0 ]
  }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator [
      {
        name: "cuda"
        parameters [
          {
            key: "precision_mode"
            value: "FP16"
          }
        ]
      }
    ]
  }
}
