{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource for Quantum Portal",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Quantum Portal — Portal latency, API throughput, GPU utilization, vLLM metrics, Triton throughput, circuit success rate, classical vs quantum accuracy",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Portal Latency",
      "type": "row"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_milliseconds_bucket{service=\"portal\"}[$__rate_interval])) by (le)) ",
          "legendFormat": "p50"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_milliseconds_bucket{service=\"portal\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_milliseconds_bucket{service=\"portal\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "title": "Portal Latency p50 / p95 / p99 (ms)",
      "type": "timeseries"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(http_requests_total{service=\"quantum-api\"}[$__rate_interval])) by (status_code)",
          "legendFormat": "HTTP {{status_code}}"
        }
      ],
      "title": "API Request Rate & Status Codes",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "GPU Metrics (DCGM)",
      "type": "row"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "GPU Util %"
        }
      ],
      "title": "GPU Utilization %",
      "type": "gauge"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 12884901888 },
              { "color": "red", "value": 20401094656 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(DCGM_FI_DEV_FB_USED) * 1024 * 1024",
          "legendFormat": "GPU VRAM Used"
        }
      ],
      "title": "GPU Memory Used",
      "type": "gauge"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "GPU {{gpu}} ({{Hostname}})"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "DCGM_FI_DEV_MEM_COPY_UTIL",
          "legendFormat": "Mem BW {{gpu}} ({{Hostname}})"
        }
      ],
      "title": "GPU Utilization % — per GPU over time",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "vLLM Inference",
      "type": "row"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 6,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(vllm:request_generation_tokens_total[$__rate_interval]))",
          "legendFormat": "Tokens/sec (generation)"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(vllm:request_prompt_tokens_total[$__rate_interval]))",
          "legendFormat": "Tokens/sec (prompt)"
        }
      ],
      "title": "vLLM Throughput — Tokens/sec",
      "type": "timeseries"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 7,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.50, sum(rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "TTFT p50 (ms)"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval])) by (le)) * 1000",
          "legendFormat": "TTFT p95 (ms)"
        }
      ],
      "title": "vLLM Time-To-First-Token (TTFT)",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Triton Inference",
      "type": "row"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 8,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(nv_inference_request_success[$__rate_interval])) by (model)",
          "legendFormat": "Success {{model}}"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(nv_inference_request_failure[$__rate_interval])) by (model)",
          "legendFormat": "Failure {{model}}"
        }
      ],
      "title": "Triton Inference Throughput (req/sec)",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 104,
      "title": "Quantum Circuit Metrics",
      "type": "row"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 37 },
      "id": 9,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(quantum_circuit_success_total[$__rate_interval])) / sum(rate(quantum_circuit_total[$__rate_interval]))",
          "legendFormat": "Circuit Success Rate"
        }
      ],
      "title": "Quantum Circuit Success Rate",
      "type": "gauge"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 37 },
      "id": 10,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "quantum_model_accuracy{model_type=\"classical\"}",
          "legendFormat": "Classical Accuracy"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "quantum_model_accuracy{model_type=\"quantum\"}",
          "legendFormat": "Quantum Accuracy"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "quantum_model_accuracy{model_type=\"hybrid\"}",
          "legendFormat": "Hybrid Accuracy"
        }
      ],
      "title": "Classical vs Quantum vs Hybrid Accuracy Trend",
      "type": "timeseries"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["quantum", "portal", "llm", "gpu"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(up, env)",
        "hide": 0,
        "includeAll": false,
        "name": "env",
        "options": [],
        "query": "label_values(up, env)",
        "refresh": 1,
        "type": "query",
        "label": "Environment"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Quantum Portal Overview",
  "uid": "quantum-portal-overview",
  "version": 1
}
