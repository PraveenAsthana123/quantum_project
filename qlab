# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def project_dir(proj_id: str) -> Path:
    return QUANTUM_ROOT / proj_id

def find_project(query: str) -> Optional[dict]:
    q = query.lower()
    for p in PROJECTS:
        if p["id"].lower() == q or q in p["id"].lower():
            return p
    return None

def project_status(proj_id: str) -> str:
    pd = project_dir(proj_id)
    src_files = list((pd / "src").glob("*.py")) if (pd / "src").exists() else []
    data_files = list((pd / "data").glob("*")) if (pd / "data").exists() else []
    ui_files   = list((pd / "ui").glob("*.py")) if (pd / "ui").exists() else []
    if not src_files and not ui_files:
        return f"{YELLOW}scaffold{RESET}"
    if src_files and ui_files:
        return f"{GREEN}ready{RESET}"
    return f"{CYAN}partial{RESET}"

def box(text: str, color: str = BLUE) -> str:
    lines = text.split("\n")
    width = max(len(l) for l in lines) + 4
    top = color + "┌" + "─" * (width - 2) + "┐" + RESET
    bot = color + "└" + "─" * (width - 2) + "┘" + RESET
    mid = "\n".join(color + "│ " + RESET + l.ljust(width - 4) + color + " │" + RESET for l in lines)
    return f"{top}\n{mid}\n{bot}"

