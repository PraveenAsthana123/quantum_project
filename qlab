def cmd_setup(proj_id: str):
    p = find_project(proj_id)
    if not p:
        print(f"{RED}Project not found: {proj_id}{RESET}")
        sys.exit(1)
    req_file = project_dir(p["id"]) / "requirements.txt"
    if not req_file.exists():
        print(f"{YELLOW}No requirements.txt found for {proj_id}. Using shared requirements.{RESET}")
        req_file = QUANTUM_ROOT / "shared" / "requirements.txt"
    print(f"{CYAN}Installing requirements for {BOLD}{p['title']}{RESET}...")
    result = subprocess.run([sys.executable, "-m", "pip", "install", "-r", str(req_file)],
                            capture_output=False)
    if result.returncode == 0:
        print(f"{GREEN}Setup complete for {proj_id}{RESET}")
    else:
        print(f"{RED}Setup failed — check pip output above{RESET}")
        sys.exit(1)


def cmd_data(proj_id: str):
    p = find_project(proj_id)
    if not p:
        print(f"{RED}Project not found: {proj_id}{RESET}")
        sys.exit(1)
    if not p["kaggle"]:
        print(f"{YELLOW}No Kaggle datasets registered for {proj_id}{RESET}")
        return
    dest = project_dir(p["id"]) / "data"
    dest.mkdir(parents=True, exist_ok=True)
    for ds in p["kaggle"]:
        print(f"{CYAN}Downloading: {ds}{RESET}")
        result = subprocess.run(
            ["kaggle", "datasets", "download", "-d", ds, "-p", str(dest), "--unzip"],
            capture_output=False
        )
        if result.returncode == 0:
            print(f"{GREEN}Downloaded {ds} → {dest}{RESET}")
        else:
            print(f"{RED}Failed to download {ds}{RESET}")


def cmd_run(proj_id: str):
    p = find_project(proj_id)
    if not p:
        print(f"{RED}Project not found: {proj_id}{RESET}")
        sys.exit(1)
    ui_dir = project_dir(p["id"]) / "ui"
    app_file = ui_dir / "app.py"
    if not app_file.exists():
        print(f"{YELLOW}No UI found at {app_file}{RESET}")
        print(f"Try: qlab notebooks {proj_id}")
        sys.exit(1)
    print(f"{CYAN}Launching {BOLD}{p['title']}{RESET}...")
    os.chdir(project_dir(p["id"]))
    os.execvp("streamlit", ["streamlit", "run", str(app_file)])


def cmd_portal():
