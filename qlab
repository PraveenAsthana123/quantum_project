    nb_dir = project_dir(p["id"]) / "notebooks"
    print(f"{CYAN}Opening Jupyter in {nb_dir}...{RESET}")
    os.execvp("jupyter", ["jupyter", "lab", "--notebook-dir", str(nb_dir)])


