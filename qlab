def cmd_list():
    print(f"\n{BOLD}{CYAN}{'='*70}")
    print(f"  Quantum Lab — Project Registry  ({len(PROJECTS)} projects)")
    print(f"{'='*70}{RESET}\n")
    cats: dict = {}
    for p in PROJECTS:
        cats.setdefault(p["category"], []).append(p)

    for cat, projs in cats.items():
        color = CATEGORY_COLORS.get(cat, WHITE)
        print(f"  {BOLD}{color}[{cat.upper()}]{RESET}")
        for p in projs:
            status = project_status(p["id"])
            sdks_str = ", ".join(p["sdks"][:3])
            print(f"    {color}{p['id']:30}{RESET} {status:25}  {DIM}{sdks_str}{RESET}")
        print()

    print(f"  {DIM}Use: qlab info <project-id>  |  qlab run <id>  |  qlab setup <id>{RESET}\n")


def cmd_status():
    total = len(PROJECTS)
    ready = sum(1 for p in PROJECTS if "ready" in project_status(p["id"]))
    partial = sum(1 for p in PROJECTS if "partial" in project_status(p["id"]))
    scaffold = total - ready - partial
    print(f"\n{BOLD}{CYAN}Quantum Lab Status{RESET}  ({QUANTUM_ROOT})\n")
    print(f"  Total projects : {BOLD}{total}{RESET}")
    print(f"  {GREEN}Ready{RESET}          : {ready}")
    print(f"  {CYAN}Partial{RESET}        : {partial}")
    print(f"  {YELLOW}Scaffold only{RESET}  : {scaffold}")
    print()
    for p in PROJECTS:
        st = project_status(p["id"])
        print(f"  {p['id']:30} {st}")
    print()


